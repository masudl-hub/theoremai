{
  "$schema": "./node_modules/fallow/schema.json",
  // Published entry points come from package.json `exports` (fallow reads it).
  "entry": [
    // Unpublished headless interface surface; still an analysis entry for react + tests.
    "src/interface/mod.ts",
    // Repo-only guardrail eval harness, run by scripts/guardrails-eval.ts (scripts/ is ignored).
    "src/guardrails/eval/mod.ts",
    "tests/cli/**/*.ts",
    "tests/kernel/**/*.ts",
    "tests/guardrails/**/*.ts",
    "tests/providers/**/*.ts",
    "tests/observability/**/*.ts",
    "tests/evals/**/*.ts",
    "tests/host/**/*.ts",
    "tests/interface/**/*.ts",
    "tests/react/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/cassettes/**/*.ts",
    "tests/fixtures/**/*.js",
    "react/src/index.ts",
    "react/src/ui/index.ts",
    "react/src/server/mod.ts",
    "react/src/live.ts",
    "react/src/client/index.ts",
    "react/src/ui/theorem-theme.ts",
    "react/src/ui/icons.ts",
    // Theorem Studio: the local server, the example project it opens, and the page.
    "studio/server/serve.ts",
    "studio/server/example.ts",
    // The studio screen, published as `@theoremjs/studio/ui/*`; the website imports its files.
    "studio/ui/**/*.{ts,tsx}",
    // What a Vite build needs to show the screen, published as `@theoremjs/studio/vite`.
    "studio/vite.mjs",
    "react/src/studio/main.tsx"
  ],
  // @astryxdesign/cli is used only as the `astryx` binary in react's theme scripts; whether fallow
  // sees it depends on react/node_modules/.bin existing, so it is declared here to keep runs stable.
  // @astryxdesign/core belongs to react/package.json; a test under tests/react may reach it through
  // react/node_modules, which fallow reads as an import the root package does not list.
  "ignoreDependencies": [
    "@ast-grep/cli",
    "@theoremjs/agents",
    "@astryxdesign/cli",
    "@astryxdesign/core"
  ],
  // docs-truth loads the ownership graph via dynamic import (graph.mjs → _map.mjs).
  // Vite's worker suffix on a package the host installs; the kernel repo has no Monaco.
  "ignoreUnresolvedImports": ["monaco-editor/editor/editor.worker?worker"],
  "dynamicallyLoaded": ["docs/_map.mjs"],
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "scripts/**",
    "src/cli/**",
    "npm/**",
    "react/npm/**"
  ],
  // Follows calls made through refs and returned clients, which the syntactic pass cannot.
  "typeAware": { "enabled": true },
  "health": {
    // Kernel turn/sanitize paths are intentionally branchy; keep these just
    // above current hotspots so health still fails on real complexity spikes.
    "maxCyclomatic": 24,
    "maxCognitive": 34,
    "maxCrap": 57,
    "maxUnitSize": 140,
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": ["studio/ui/code/studio-code.tsx"],
        "maxUnitSize": 210,
        "reason": "The code view mounts Monaco in one effect: the editor, its worker and its listeners share that scope. Moved from the website as it was."
      },
      {
        "files": ["studio/ui/**", "studio/vite.mjs"],
        "maxCrap": 307,
        "reason": "The studio screen moved here from the website with no coverage: its tests still run there and move with the page. Just above the current worst (facetEditor), so nothing new may exceed it."
      }
    ]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependency": "error",
    "re-export-cycle": "error",
    "unresolved-imports": "error",
    "private-type-leaks": "error",
    "boundary-violations": "error",
    "stale-suppressions": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unused-dependency-overrides": "error",
    // CSS quality is tracked but not CI-blocking until react style debt is cleared.
    "css-token-drift": "warn",
    "css-duplicate-block": "warn",
    "css-selector-complexity": "warn",
    "css-dead-surface": "warn",
    "css-broken-reference": "warn"
  },
  "duplicates": {
    "mode": "strict",
    "minTokens": 40,
    "minLines": 5,
    "minOccurrences": 2,
    "ignoreImports": true,
    // Generated tables (scripts/gen-egress-automata.ts): repeated rows are data.
    "ignore": ["src/guardrails/egress-automata.ts"],
    // Hard ceiling: any meaningful duplication fails until clone groups are cleared.
    "threshold": 0.5
  },
  // PR gate: fail only on findings this changeset introduces (fallow default).
  "audit": {
    "gate": "new-only"
  }
}
