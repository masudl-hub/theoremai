{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "mod.ts",
    "src/kernel/mod.ts",
    "src/providers/mod.ts",
    "src/providers/local/mod.ts",
    "src/guardrails/mod.ts",
    "src/observability/mod.ts",
    "src/presets/mod.ts",
    "src/presets/google.ts",
    "src/host/mod.ts",
    "src/cli/index.ts",
    "tests/cli/**/*.ts",
    "tests/kernel/**/*.ts",
    "tests/guardrails/**/*.ts",
    "tests/providers/**/*.ts",
    "tests/observability/**/*.ts",
    "tests/host/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/fixtures/**/*.js"
  ],
  "ignoreDependencies": ["@ast-grep/cli"],
  // docs-truth loads the ownership graph via dynamic import (graph.mjs → _map.mjs).
  "dynamicallyLoaded": ["docs/_map.mjs"],
  "ignorePatterns": ["node_modules/**", "coverage/**", "scripts/**", "src/cli/**", "npm/**"],
  "health": {
    // Kernel turn/sanitize paths are intentionally branchy; keep these just
    // above current hotspots so health still fails on real complexity spikes.
    "maxCyclomatic": 24,
    "maxCognitive": 34,
    "maxCrap": 57,
    "maxUnitSize": 140,
    "coverage": "coverage/coverage-final.json"
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "circular-dependency": "error",
    "unresolved-imports": "error",
    "private-type-leaks": "error",
    "boundary-violations": "error"
  },
  "duplicates": {
    "mode": "strict",
    "minTokens": 40,
    "minLines": 5,
    "minOccurrences": 2,
    "ignoreImports": true
  },
  "audit": {
    "gate": "all"
  }
}
