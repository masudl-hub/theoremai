{
  "name": "@theoremjs/react",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/live.ts",
    "./src/ui/index.ts"
  ],
  "description": "React bindings for Theorem: headless hooks + transport, an Astryx chat UI, and a Web-standard server handler.",
  "scripts": {
    "typecheck": "tsc -p .",
    "theme:build": "node ../scripts/theme.mjs build",
    "theme:check": "node ../scripts/theme.mjs check"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/theme": "./src/ui/theorem-theme.ts",
    "./ui/icons": "./src/ui/icons.ts",
    "./server": "./src/server/mod.ts",
    "./live": "./src/live.ts",
    "./client": "./src/client/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@speed-highlight/core": "2.1.0",
    "@tabler/icons-react": "^3.46.0",
    "intl-messageformat": "^11.2.9",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@theoremjs/agents": "file:..",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@astryxdesign/core": {
      "optional": true
    },
    "@astryxdesign/theme-neutral": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    }
  }
}
