{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --ignore=tests/kernel/zero-permission-import.test.ts --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run tests/kernel"
  },
  "mutate": [
    "src/kernel/auth/**/*.ts"
  ],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": ".stryker-cache/auth-incremental.json",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 92
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "ignoreStatic": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
