{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys tests/guardrails/ tests/cli/fuzz-guardrails.test.ts"
  },
  "mutate": [
    "src/guardrails/injection.ts"
  ],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "incremental": false,
  "timeoutMS": 60000,
  "concurrency": 1,
  "ignoreStatic": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
