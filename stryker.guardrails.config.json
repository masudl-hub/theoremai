{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys tests/guardrails/ tests/cli/fuzz-guardrails.test.ts"
  },
  "mutate": [
    "src/guardrails/**/*.ts",
    "!src/guardrails/corpus/**",
    "!src/guardrails/testing.ts",
    "!src/guardrails/mod.ts"
  ],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": ".stryker-cache/guardrails-incremental.json",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 75
  },
  "timeoutMS": 60000,
  "concurrency": 1,
  "ignoreStatic": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
