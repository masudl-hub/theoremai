{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run tests/providers tests/cassettes"
  },
  "mutate": [
    "src/providers/**/*.ts",
    "!src/providers/google/interactions/stream.ts"
  ],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow",
    ".stryker-tmp-providers"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": ".stryker-cache/providers-incremental.json",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": null
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "ignoreStatic": false,
  "tempDirName": ".stryker-tmp-providers",
  "jsonReporter": {
    "fileName": "reports/mutation/providers.json"
  }
}
