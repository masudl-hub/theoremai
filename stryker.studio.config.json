{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --parallel --fail-fast --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run --ignore=tests/studio/compile-workspace.test.ts,tests/studio/server-e2e.test.ts tests/studio"
  },
  "mutate": ["studio/**/*.ts", "!studio/server/example.ts", "!studio/e2e/**"],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow",
    ".stryker-tmp-studio"
  ],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": ".stryker-cache/studio-incremental.json",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": null
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "ignoreStatic": false,
  "tempDirName": ".stryker-tmp-studio",
  "jsonReporter": {
    "fileName": "reports/mutation/studio.json"
  }
}
