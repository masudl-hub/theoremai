{
  "name": "@theoremjs/studio",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./ui/boot-mark.tsx",
    "./ui/code/studio-monaco.ts",
    "./ui/map-token.tsx",
    "./ui/prompt-editor.tsx",
    "./ui/read-map.tsx",
    "./ui/studio-map.tsx",
    "./ui/studio-run.tsx",
    "./ui/studio-screen.tsx",
    "./ui/studio-shell.tsx",
    "./ui/theorem-mark.tsx",
    "./ui/tree-map.tsx"
  ],
  "description": "The studio's source: the profile draft, its tree and compiler, source export, and the studio screen. `npm run build:npm:studio` builds @theoremjs/studio from it into npm/, at the root package's version; this folder is never published itself. Opt-in: nothing here is installed with the kernel or the React package; `npm install` in this folder is what lets the screen run on its own.",
  "scripts": {
    "test": "node installed.mjs && npm run theme:check && deno test --config ../deno.json --no-check --allow-read --allow-write --allow-env --allow-sys tests",
    "test:browser": "playwright test --config e2e/playwright.config.ts",
    "theme:build": "node ../scripts/theme.mjs build studio",
    "theme:check": "node ../scripts/theme.mjs check studio"
  },
  "exports": {
    ".": "./mod.ts",
    "./runtime": "./runtime.ts",
    "./browser": "./browser.ts",
    "./people": "./people.ts",
    "./surface": "./surface.ts",
    "./server": "./server.ts",
    "./ui/*": "./ui/*",
    "./vite": "./vite.mjs"
  },
  "dependencies": {
    "@astryxdesign/richtext": "0.7.7",
    "@fontsource/figtree": "^5.3.0",
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@tabler/icons-react": "^3.46.0",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.2",
    "lexical": "^0.52.0",
    "monaco-editor": "^0.57.0"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.7",
    "@astryxdesign/theme-neutral": "0.7.7",
    "@playwright/test": "1.63.0",
    "@stylexjs/stylex": "0.19.0",
    "@theoremjs/agents": "file:..",
    "@theoremjs/react": "file:../react",
    "@theoremjs/web": "file:../web",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
